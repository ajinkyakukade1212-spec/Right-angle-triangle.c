
#include <stdio.h>

int graph[10][10], visited[10], n;

// DFS function
void DFS(int v)
{
    int i;

    visited[v] = 1;
    printf("%d ", v);

    // Visit connected buildings
    for (i = 0; i < n; i++)
    {
        if (graph[v][i] == 1 && !visited[i])
        {
            DFS(i);
        }
    }
}

int main()
{
    int i, j, start;

    printf("Enter number of buildings: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    printf("Enter starting building: ");
    scanf("%d", &start);

    printf("DFS traversal: ");
    DFS(start);

    return 0;
}

