
#include <stdio.h>

int main()
{
    float arr[100], temp;
    int n, i, j;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d prices: ", n);

    for (i = 0; i < n; i++)
    {
        scanf("%f", &arr[i]);
    }

    // Bubble Sort
    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("Prices after Bubble Sort:\n");

    for (i = 0; i < n; i++)
    {
        printf("%.2f ", arr[i]);
    }

    return 0;
}

